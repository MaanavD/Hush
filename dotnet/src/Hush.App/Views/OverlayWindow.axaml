<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hush.App.ViewModels"
        x:Class="Hush.App.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="Hush Overlay"
        Width="304" Height="124"
        SystemDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        FontFamily="{StaticResource Hush.Font}">

    <Panel>
        <!-- Preparing state -->
        <Border Classes="Bubble"
                BorderBrush="#9E9B7FEB"
                IsVisible="{Binding IsPreparing}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Ellipse Classes="StatusDot" Fill="#9B7FEB" />
                    <StackPanel Grid.Column="1" Margin="8 0 0 0" Spacing="1">
                        <TextBlock Text="Preparing"
                                   Classes="BubbleTitle" />
                        <TextBlock Text="{Binding PreparingDetail}"
                                   Classes="BubbleDetail"
                                   IsVisible="{Binding HasPreparingDetail}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Classes="ModeChip"
                            BorderBrush="#669B7FEB"
                            Background="#1A9B7FEB">
                        <TextBlock Text="PREP"
                                   Foreground="#9B7FEB" />
                    </Border>
                </Grid>
                <Border Grid.Row="1" Classes="WaveHost">
                    <TextBlock Text="{Binding ModelDownloadProgress, StringFormat={}{0:P0}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#9B7FEB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ShowPreparingProgress}" />
                </Border>
                <TextBlock Grid.Row="2"
                           Text="Loading local model"
                           Classes="BubbleHint" />
            </Grid>
        </Border>

        <!-- Raw listening state -->
        <Border Classes="Bubble"
                BorderBrush="#9E9B7FEB"
                IsVisible="{Binding IsListeningRaw}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Ellipse Classes="StatusDot" Fill="#E05757" />
                    <StackPanel Grid.Column="1" Margin="8 0 0 0" Spacing="1">
                        <TextBlock Text="Listening"
                                   Classes="BubbleTitle" />
                        <TextBlock Text="{Binding TranscriptText}"
                                   Classes="BubbleDetail"
                                   IsVisible="{Binding HasTranscript}" />
                        <TextBlock Text="Waiting for speech"
                                   Classes="BubbleDetail"
                                   IsVisible="{Binding ShowListeningHint}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Classes="ModeChip"
                            BorderBrush="#669B7FEB"
                            Background="#1A9B7FEB">
                        <TextBlock Text="RAW"
                                   Foreground="#9B7FEB" />
                    </Border>
                </Grid>
                <Border Grid.Row="1" Classes="WaveHost">
                    <Canvas x:Name="WaveCanvas"
                            Width="252"
                            Height="40" />
                </Border>
                <TextBlock Grid.Row="2"
                           Text="Typing live into the focused app"
                           Classes="BubbleHint" />
            </Grid>
        </Border>

        <!-- Clean listening state -->
        <Border Classes="Bubble Clean"
                BorderBrush="#9EF59E0B"
                IsVisible="{Binding IsListeningClean}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Ellipse Classes="StatusDot" Fill="#E05757" />
                    <StackPanel Grid.Column="1" Margin="8 0 0 0" Spacing="1">
                        <TextBlock Text="Listening clean"
                                   Classes="BubbleTitle" />
                        <TextBlock Text="{Binding TranscriptText}"
                                   Classes="BubbleDetail"
                                   IsVisible="{Binding HasTranscript}" />
                        <TextBlock Text="Waiting for speech"
                                   Classes="BubbleDetail"
                                   IsVisible="{Binding ShowListeningHint}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Classes="ModeChip"
                            BorderBrush="#66F59E0B"
                            Background="#1CF59E0B">
                        <TextBlock Text="CLEAN"
                                   Foreground="#F59E0B" />
                    </Border>
                </Grid>
                <Border Grid.Row="1" Classes="WaveHost">
                    <Canvas x:Name="WaveCanvasClean"
                            Width="252"
                            Height="40" />
                </Border>
                <TextBlock Grid.Row="2"
                           Text="Release to rewrite into the focused app"
                           Classes="BubbleHint" />
            </Grid>
        </Border>

        <!-- Finalizing state -->
        <Border Classes="Bubble Clean"
                BorderBrush="#9EF59E0B"
                IsVisible="{Binding ShowFinalizingHint}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Ellipse Classes="StatusDot" Fill="#F59E0B" />
                    <StackPanel Grid.Column="1" Margin="8 0 0 0" Spacing="1">
                        <TextBlock Text="Rewriting"
                                   Classes="BubbleTitle" />
                        <TextBlock Text="Clean mode is preparing final text"
                                   Classes="BubbleDetail" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Classes="ModeChip"
                            BorderBrush="#66F59E0B"
                            Background="#1CF59E0B">
                        <TextBlock Text="CLEAN"
                                   Foreground="#F59E0B" />
                    </Border>
                </Grid>
                <Border Grid.Row="1" Classes="WaveHost">
                    <Canvas x:Name="WaveCanvasFinalizing"
                            Width="252"
                            Height="40" />
                </Border>
                <TextBlock Grid.Row="2"
                           Text="Stay focused in the target app"
                           Classes="BubbleHint" />
            </Grid>
        </Border>

        <!-- Cleaning model warmup -->
        <Border Classes="Bubble Clean"
                BorderBrush="#9EF59E0B"
                IsVisible="{Binding ShowCleaningModelBanner}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Ellipse Classes="StatusDot" Fill="#F59E0B" />
                    <StackPanel Grid.Column="1" Margin="8 0 0 0" Spacing="1">
                        <TextBlock Text="Raw ready"
                                   Classes="BubbleTitle" />
                        <TextBlock Text="{Binding CleaningModelStatus}"
                                   Classes="BubbleDetail" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Classes="ModeChip"
                            BorderBrush="#66F59E0B"
                            Background="#1CF59E0B">
                        <TextBlock Text="CLEAN"
                                   Foreground="#F59E0B" />
                    </Border>
                </Grid>
                <Border Grid.Row="1" Classes="WaveHost">
                    <TextBlock Text="{Binding CleaningModelDownloadProgress, StringFormat={}{0:P0}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#F59E0B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ShowCleaningModelDownloadProgress}" />
                </Border>
                <TextBlock Grid.Row="2"
                           Text="Clean mode is warming up"
                           Classes="BubbleHint" />
            </Grid>
        </Border>

        <!-- Error state -->
        <Border Classes="Bubble Error"
                BorderBrush="#B8C94040"
                IsVisible="{Binding HasError}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Ellipse Classes="StatusDot" Fill="#C94040" />
                    <StackPanel Grid.Column="1" Margin="8 0 0 0" Spacing="1">
                        <TextBlock Text="Error"
                                   Classes="BubbleTitle" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Classes="BubbleDetail" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Classes="ModeChip"
                            BorderBrush="#66C94040"
                            Background="#1FC94040">
                        <TextBlock Text="ERR"
                                   Foreground="#F87171" />
                    </Border>
                </Grid>
                <Border Grid.Row="1" Classes="WaveHost">
                    <TextBlock Text="Open Settings if this persists"
                               Classes="BubbleHint"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Row="2"
                           Text="Hush could not continue"
                           Classes="BubbleHint" />
            </Grid>
        </Border>
    </Panel>

    <Window.Styles>
        <Style Selector="Border.Bubble">
            <Setter Property="Width" Value="276" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Padding" Value="12 10 12 9" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#F411111F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 18 42 0 #6B000000" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Ellipse.StatusDot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.BubbleTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F8F8FF" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.BubbleDetail">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#BEBCDA" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.BubbleHint">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#7E7C9C" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.ModeChip">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8 3" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.ModeChip TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.WaveHost">
            <Setter Property="Width" Value="252" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#0AEEEEF8" />
            <Setter Property="Margin" Value="0 5 0 2" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </Window.Styles>
</Window>
