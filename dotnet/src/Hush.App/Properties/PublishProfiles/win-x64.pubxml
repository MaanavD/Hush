<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained single .exe: .NET runtime + Foundry Local Core + ORT + GenAI
         are all bundled and extracted at startup. Users do NOT need to install
         .NET or Foundry Local separately. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Strip PDBs and ORT import-library stubs from the output folder -->
    <DebugType>none</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <!-- Delete ORT .lib stub files and PDBs from the output folder; not needed at runtime -->
  <Target Name="RemoveNonRuntimeFiles" AfterTargets="Publish">
    <ItemGroup>
      <_FilesToRemove Include="$(PublishDir)*.lib" />
      <_FilesToRemove Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_FilesToRemove)" />
  </Target>
</Project>
