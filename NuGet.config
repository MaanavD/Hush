<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Local package source: place any pre-release .nupkg files (e.g.
      Microsoft.AI.Foundry.Local) in the repo root and they will be
      resolved from here. This is a temporary measure until the SDK
      packages are published to nuget.org.
    -->
    <add key="local-hush" value="packages" />
    <!--
      ORT-Nightly feed: hosts pre-release Microsoft.AI.Foundry.Local.* and
      Microsoft.ML.OnnxRuntime.Foundry builds that aren't on nuget.org yet.
    -->
    <add key="ort-nightly" value="https://pkgs.dev.azure.com/aiinfra/PublicPackages/_packaging/ORT-Nightly/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Package source mapping: tell NuGet exactly which feed serves each package
    namespace. Without this, NuGet may fan out a single resolve across every
    configured feed (including upstreamed proxies like ort-nightly) and fail
    on first 401 even though nuget.org has the package. Mapping cuts that
    noise and speeds up restore.
  -->
  <packageSourceMapping>
    <packageSource key="ort-nightly">
      <package pattern="Microsoft.AI.Foundry.Local*" />
      <package pattern="Microsoft.ML.OnnxRuntime*" />
    </packageSource>
    <packageSource key="local-hush">
      <package pattern="Microsoft.AI.Foundry.Local*" />
      <package pattern="Microsoft.ML.OnnxRuntime*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
