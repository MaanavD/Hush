<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Local package source: place any pre-release .nupkg files (e.g.
      Microsoft.AI.Foundry.Local) in the repo root and they will be
      resolved from here. This is a temporary measure until the SDK
      packages are published to nuget.org.
    -->
    <add key="local-hush" value="." />
  </packageSources>
</configuration>
