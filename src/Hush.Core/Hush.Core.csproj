<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- New managed SDK targets net9.0 on all platforms -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net9.0-windows10.0.26100</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net9.0</TargetFramework>
    <!-- RuntimeIdentifier required so NuGet resolves native assets from Foundry Local Core on all platforms.
         Use portable RIDs so restore avoids distro-specific host package gaps.
         Note: osx-x64 is not shipped by Foundry Local Core — only osx-arm64 (Apple Silicon). -->
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>false</SelfContained>
    <RootNamespace>Hush.Core</RootNamespace>
    <AssemblyName>Hush.Core</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Foundry Local managed SDK (unified, replaces WinML + old cross-platform variants) -->
    <PackageReference Include="Microsoft.AI.Foundry.Local" Version="1.0.0-dev.202604071256" />
    <!-- Explicit Core pin: SDK nuspec declares an older transitive dep; override with local build -->
    <PackageReference Include="Microsoft.AI.Foundry.Local.Core" Version="1.0.0-dev-202604071256-f3a8039f" />

    <!-- Audio capture — NAudio on Windows; macOS/Linux backend TBD after validation spike -->
    <PackageReference Include="NAudio"
                      Version="2.3.0"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.14" />
  </ItemGroup>

</Project>
