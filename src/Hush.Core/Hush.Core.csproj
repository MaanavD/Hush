<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinML SDK requires net8.0-windows10.0.26100; cross-platform SDK supports net9.0 -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0-windows10.0.26100</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net9.0</TargetFramework>
    <!-- WinML has native binaries — we need a RID so restore picks the right one -->
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>false</SelfContained>
    <RootNamespace>Hush.Core</RootNamespace>
    <AssemblyName>Hush.Core</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Windows App SDK requires this flag when PublishSingleFile=true -->
    <EnableMsixTooling Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- Foundry Local SDK — conditional per platform -->
    <PackageReference Include="Microsoft.AI.Foundry.Local.WinML"
                      Version="0.9.0"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Microsoft.AI.Foundry.Local"
                      Version="0.9.0"
                      Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />

    <!-- Audio capture — NAudio on Windows; macOS/Linux backend TBD after validation spike -->
    <PackageReference Include="NAudio"
                      Version="2.3.0"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.14" />
  </ItemGroup>

</Project>
