<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Always target plain `net9.0` so macOS / Linux cross-publish from a
      Windows dev box works. Windows-specific behaviour is gated through the
      HUSH_WINDOWS compile constant and the _IsWindowsTarget property below,
      which are driven by the target runtime identifier (`-r win-x64`,
      `-r osx-arm64`, …) rather than the host OS.
    -->
    <TargetFramework>net9.0</TargetFramework>

    <_IsWindowsTarget Condition="'$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">true</_IsWindowsTarget>
    <_IsWindowsTarget Condition="$(RuntimeIdentifier.StartsWith('win'))">true</_IsWindowsTarget>
    <_IsWindowsTarget Condition="'$(_IsWindowsTarget)' == ''">false</_IsWindowsTarget>

    <DefineConstants Condition="'$(_IsWindowsTarget)' == 'true'">$(DefineConstants);HUSH_WINDOWS</DefineConstants>

    <!-- Default RID when none supplied — used for `dotnet build` without `-r`. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>

    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>false</SelfContained>
    <!-- MVVMTK0045 warns about WinRT/UWP AOT compatibility. Hush uses Avalonia, not WinRT. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <RootNamespace>Hush.App</RootNamespace>
    <AssemblyName>Hush.App</AssemblyName>
    <!-- Shown in File Explorer → Properties → Details. -->
    <Product>Hush</Product>
    <AssemblyTitle>Hush</AssemblyTitle>
    <Description>Private, offline, free voice-to-text for your desktop.</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- Windows-only: ship an exe with our own icon and app manifest
         (DPI awareness, supported-OS declarations, asInvoker). -->
    <ApplicationIcon Condition="'$(_IsWindowsTarget)' == 'true'">Assets\hush-icon.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(_IsWindowsTarget)' == 'true'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hush.Core\Hush.Core.csproj" />
    <!--
      Pin the Avalonia core packages to the 11.3.x line. Avalonia.ReactiveUI has no 12.x
      release yet, so a 12.x core would create a mismatched, unbuildable package set
      (Avalonia 12 also removed IClipboard.SetTextAsync). Keep these aligned with
      Avalonia.ReactiveUI until a matching ReactiveUI 12 ships. See dependabot.yml ignore rule.
    -->
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!--
    Optional: Override onnxruntime-genai.dll with a custom build.

    WHY THIS EXISTS:
    The NuGet-shipped onnxruntime-genai (transitive from Foundry Local Core)
    may not support the Nemotron RNN-T model configuration used by Hush.
    If you have a compatible custom build (e.g. from the Foundry Local service),
    place it at src/Hush.Core/runtimes/win-x64/native/onnxruntime-genai.dll
    and these targets will automatically copy it over the NuGet version.

    If the file does not exist, these targets are silently skipped (no-op).
    Most contributors do NOT need this — it is only required when the
    NuGet-shipped GenAI runtime lacks support for the target model format.
  -->
  <Target Name="OverrideGenAI" AfterTargets="Build"
          Condition="'$(_IsWindowsTarget)' == 'true' AND Exists('$(MSBuildProjectDirectory)\..\Hush.Core\runtimes\win-x64\native\onnxruntime-genai.dll')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\Hush.Core\runtimes\win-x64\native\onnxruntime-genai.dll"
          DestinationFiles="$(OutputPath)onnxruntime-genai.dll"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <!-- For single-file publish: override BEFORE GenerateSingleFileBundle bundles
       native DLLs into the exe. AfterTargets="Publish" would be too late. -->
  <Target Name="OverrideGenAIPublish"
          AfterTargets="CopyFilesToPublishDirectory"
          BeforeTargets="GenerateSingleFileBundle"
          Condition="'$(_IsWindowsTarget)' == 'true' AND Exists('$(MSBuildProjectDirectory)\..\Hush.Core\runtimes\win-x64\native\onnxruntime-genai.dll')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\Hush.Core\runtimes\win-x64\native\onnxruntime-genai.dll"
          DestinationFiles="$(PublishDir)onnxruntime-genai.dll"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>

</Project>
