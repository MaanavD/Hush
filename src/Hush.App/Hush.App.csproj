<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- New managed SDK targets net9.0 on all platforms -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net9.0-windows10.0.26100</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net9.0</TargetFramework>
    <!-- RuntimeIdentifier propagated from Hush.Core native packages (required on all platforms) -->
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>false</SelfContained>
    <!-- MVVMTK0045 warns about WinRT/UWP AOT compatibility. Hush uses Avalonia, not WinRT. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <RootNamespace>Hush.App</RootNamespace>
    <AssemblyName>Hush.App</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Hush</Product>
    <Copyright>Copyright © 2026 Maanav Dalal. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hush.Core\Hush.Core.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!--
    Optional: Override onnxruntime-genai.dll with a custom build.

    WHY THIS EXISTS:
    The NuGet-shipped onnxruntime-genai (transitive from Foundry Local Core)
    may not support the Nemotron RNN-T model configuration used by Hush.
    If you have a compatible custom build (e.g. from the Foundry Local service),
    place it at src/Hush.Core/runtimes/win-x64/native/onnxruntime-genai.dll
    and these targets will automatically copy it over the NuGet version.

    If the file does not exist, these targets are silently skipped (no-op).
    Most contributors do NOT need this — it is only required when the
    NuGet-shipped GenAI runtime lacks support for the target model format.
  -->
  <Target Name="OverrideGenAI" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) AND Exists('$(MSBuildProjectDirectory)\..\Hush.Core\runtimes\win-x64\native\onnxruntime-genai.dll')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\Hush.Core\runtimes\win-x64\native\onnxruntime-genai.dll"
          DestinationFiles="$(OutputPath)onnxruntime-genai.dll"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <!-- For single-file publish: override BEFORE GenerateSingleFileBundle bundles
       native DLLs into the exe. AfterTargets="Publish" would be too late. -->
  <Target Name="OverrideGenAIPublish"
          AfterTargets="CopyFilesToPublishDirectory"
          BeforeTargets="GenerateSingleFileBundle"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) AND Exists('$(MSBuildProjectDirectory)\..\Hush.Core\runtimes\win-x64\native\onnxruntime-genai.dll')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\Hush.Core\runtimes\win-x64\native\onnxruntime-genai.dll"
          DestinationFiles="$(PublishDir)onnxruntime-genai.dll"
          OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>

</Project>
