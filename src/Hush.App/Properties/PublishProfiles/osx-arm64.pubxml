<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\osx-arm64\</PublishDir>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- .dylib native libs are extracted to a temp dir at first launch -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Strip debug symbols from output -->
    <DebugType>none</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
    <!--
      IMPORTANT — macOS packaging note
      ─────────────────────────────────
      This profile produces a raw Mach-O binary suitable for testing.
      For production distribution, the binary must be placed inside a
      Hush.app bundle (using Assets/Info.plist), signed with an Apple
      Developer certificate, and notarized before Gatekeeper will allow
      it to run on end-user machines.

      osx-x64 (Intel Mac) is NOT supported: the Foundry Local Core package
      ships runtimes/osx-arm64 only. Apple Silicon (M1 and later) required.
    -->
  </PropertyGroup>

  <!-- Delete any PDBs or dSYM stubs left in the publish folder -->
  <Target Name="RemoveNonRuntimeFiles" AfterTargets="Publish">
    <ItemGroup>
      <_FilesToRemove Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_FilesToRemove)" />
  </Target>
</Project>
