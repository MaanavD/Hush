<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hush.App.ViewModels"
        x:Class="Hush.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Hush — Settings"
        Icon="avares://Hush.App/Assets/hush-icon.png"
        Width="460" Height="860"
        MinHeight="610" MaxHeight="1100"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        FontFamily="{StaticResource Hush.Font}">

    <!--
        Settings layout (impeccable.style principles):
          • Grouped by concern — surface hierarchy through section labels, not visual weight alone
          • Two-column rows (label + control) so relatedness is spatial, not only textual
          • Generous whitespace between sections; tight rhythm within them
          • Section labels in ALL-CAPS at 9px signal structure without competing with content
          • Action at the bottom-right — familiar desktop convention
    -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="28 22 28 16"
                BorderBrush="{StaticResource Hush.Border.Brush}"
                BorderThickness="0 0 0 1">
            <StackPanel Spacing="2">
                <TextBlock Text="Settings"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                <TextBlock Text="Changes are saved when you close this window."
                           FontSize="11"
                           Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
            </StackPanel>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" Margin="0">
            <StackPanel Margin="28 20 28 4" Spacing="0">

                <!-- Section: Input -->
                <TextBlock Text="INPUT"
                           FontSize="9"
                           FontWeight="Bold"
                           LetterSpacing="2"
                           Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                           Margin="0 0 0 10" />

                <!-- Hotkey -->
                <Grid ColumnDefinitions="160,*" Margin="0 0 0 10">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4"
                                    Background="{StaticResource Hush.Accent.Brush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Global hotkey"
                                       FontSize="13"
                                       Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        </StackPanel>
                        <TextBlock Text="Hold to dictate"
                                   FontSize="10"
                                   Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                                   Margin="14 0 0 0" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Text="{Binding Hotkey}"
                             Watermark="Ctrl+H"
                             ToolTip.Tip="Hotkey combination to hold for push-to-talk dictation. Changes take effect as soon as you save." />
                </Grid>

                <!-- Language -->
                <Grid ColumnDefinitions="160,*" Margin="0 0 0 10">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Language code"
                                   FontSize="13"
                                   Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        <TextBlock Text="ISO 639-1 or locale"
                                   FontSize="10"
                                   Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Text="{Binding Language}"
                             Watermark="en"
                             ToolTip.Tip="Changes apply to the next dictation session without restarting the app. Use a language hint like en, fr, es, de, ja, or pt-BR. Common aliases like jp are normalized to ja." />
                </Grid>

                <!-- Microphone -->
                <Grid ColumnDefinitions="160,*" Margin="0 0 0 24">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Microphone"
                                   FontSize="13"
                                   Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        <TextBlock Text="Audio input device"
                                   FontSize="10"
                                   Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableMicrophones}"
                              SelectedIndex="{Binding SelectedMicrophoneIndex}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="Choose a specific microphone or leave on System Default. Takes effect on next dictation." />
                </Grid>

                <!-- Section: Clean Mode -->
                <TextBlock Text="CLEAN MODE"
                           FontSize="9" FontWeight="Bold" LetterSpacing="2"
                           Foreground="{StaticResource Hush.CleanMode.Brush}"
                           Margin="0 0 0 10" />

                <!-- Clean hotkey -->
                <Grid ColumnDefinitions="160,*" Margin="0 0 0 10">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4"
                                    Background="{StaticResource Hush.CleanMode.Brush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="Clean hotkey"
                                       FontSize="13" Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        </StackPanel>
                        <TextBlock Text="Runs LLM rewrite"
                                   FontSize="10" Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                                   Margin="14 0 0 0" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Text="{Binding CleanHotkey}"
                             Watermark="Alt+H"
                             ToolTip.Tip="Hold this key for clean-mode dictation. The full transcript is processed by a small language model before being typed. Max 2 keypresses (1 modifier + 1 key)." />
                </Grid>

                <!-- Post-processing toggle -->
                <Grid ColumnDefinitions="160,*" Margin="0 0 0 10">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="LLM rewrite (coming soon)"
                                   FontSize="13" Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        <TextBlock Text="On clean-mode sessions"
                                   FontSize="10" Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding PostProcessingEnabled}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  OffContent="" OnContent=""
                                  ToolTip.Tip="LLM rewrite will be active once the post-processing feature ships. Saving this setting now means it will take effect automatically." />
                </Grid>

                <!-- LLM model -->
                <Grid ColumnDefinitions="160,*" Margin="0 0 0 6">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="LLM model (coming soon)"
                                   FontSize="13" Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        <TextBlock Text="Foundry Local alias"
                                   FontSize="10" Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Text="{Binding PostProcessingModel}"
                             Watermark="qwen3-0.6b"
                             IsEnabled="{Binding PostProcessingEnabled}"
                             ToolTip.Tip="Foundry Local model alias for LLM rewriting. Must be a small chat model (~400 MB)." />
                </Grid>
                <TextBlock Text="Model loads on first clean-mode use. Requires ~400 MB disk space."
                           FontSize="10" Foreground="{StaticResource Hush.Text.Muted.Brush}"
                           Margin="0 0 0 24" />

                <!-- Section: Prompts -->
                <TextBlock Text="PROMPTS"
                           FontSize="9" FontWeight="Bold" LetterSpacing="2"
                           Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                           Margin="0 0 0 10" />

                <TextBlock Text="Templates used by clean-mode LLM rewriting. Pick one that matches how you'll use the dictated text."
                           FontSize="10" Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                           TextWrapping="Wrap"
                           Margin="0 0 0 8" />

                <!-- Prompt picker: card-style list with icon, name, and use-case description -->
                <ListBox ItemsSource="{Binding AllPrompts}"
                         SelectedItem="{Binding SelectedPrompt}"
                         MaxHeight="280"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0 0 0 8">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0 0 0 6" />
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource Hush.Accent.Brush}" />
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LlmPromptViewModel">
                            <Border Padding="12 10"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Hush.Border.Brush}">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Icon}"
                                               FontSize="20"
                                               VerticalAlignment="Center"
                                               Margin="0 0 12 0" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            IsVisible="{Binding IsBuiltIn}"
                                            Background="{StaticResource Hush.Surface.Brush}"
                                            CornerRadius="4"
                                            Padding="6 2"
                                            VerticalAlignment="Center"
                                            Margin="8 0 0 0">
                                        <TextBlock Text="Built-in"
                                                   FontSize="9"
                                                   LetterSpacing="1"
                                                   Foreground="{StaticResource Hush.Text.Muted.Brush}" />
                                    </Border>
                                    <Border Grid.Column="2"
                                            IsVisible="{Binding IsUserDefined}"
                                            Background="{StaticResource Hush.Surface.Brush}"
                                            CornerRadius="4"
                                            Padding="6 2"
                                            VerticalAlignment="Center"
                                            Margin="8 0 0 0">
                                        <TextBlock Text="Custom"
                                                   FontSize="9"
                                                   LetterSpacing="1"
                                                   Foreground="{StaticResource Hush.Text.Muted.Brush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Selected prompt preview -->
                <Border IsVisible="{Binding SelectedPrompt, Converter={x:Static ObjectConverters.IsNotNull}}"
                        BorderBrush="{StaticResource Hush.Border.Brush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0 0 0 8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PROMPT PREVIEW"
                                   FontSize="9" FontWeight="Bold" LetterSpacing="2"
                                   Foreground="{StaticResource Hush.Text.Muted.Brush}" />
                        <TextBlock Text="{Binding SelectedPrompt.Prompt}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                                   MaxHeight="140" />
                    </StackPanel>
                </Border>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 0 0 8">
                    <Button Content="+ New custom prompt"
                            Command="{Binding AddPromptCommand}"
                            Padding="10 5" FontSize="12" />
                    <Button Content="Edit"
                            Command="{Binding EditPromptCommand}"
                            CommandParameter="{Binding SelectedPrompt}"
                            IsVisible="{Binding SelectedPrompt.IsUserDefined, FallbackValue=False}"
                            Padding="10 5" FontSize="12" />
                    <Button Content="Remove"
                            Command="{Binding DeletePromptCommand}"
                            CommandParameter="{Binding SelectedPrompt}"
                            IsVisible="{Binding SelectedPrompt.IsUserDefined, FallbackValue=False}"
                            Padding="10 5" FontSize="12" />
                </StackPanel>

                <!-- Inline editor -->
                <Border IsVisible="{Binding IsEditingPrompt}"
                        BorderBrush="{StaticResource Hush.Border.Brush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0 0 0 8">
                    <StackPanel Spacing="8">
                        <TextBox Text="{Binding EditingPromptName}"
                                 Watermark="Prompt name"
                                 FontSize="12" />
                        <TextBox Text="{Binding EditingPromptText}"
                                 Watermark="Fix punctuation, capitalization, and grammar. Return only the corrected text."
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save"
                                    Command="{Binding SavePromptCommand}"
                                    Padding="12 6" FontSize="12" />
                            <Button Content="Cancel"
                                    Command="{Binding CancelEditCommand}"
                                    Padding="12 6" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Spacer to next section -->
                <Border Height="1" Margin="0 4 0 20" />

                <!-- Section: Dictionary -->
                <TextBlock Text="DICTIONARY"
                           FontSize="9" FontWeight="Bold" LetterSpacing="2"
                           Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                           Margin="0 0 0 10" />

                <TextBlock Text="Words the transcription model gets wrong consistently."
                           FontSize="10" Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                           Margin="0 0 0 8" />

                <!-- Empty state -->
                <TextBlock Text="No substitutions yet. Example: foundry local → Foundry Local"
                           FontSize="11" Foreground="{StaticResource Hush.Text.Muted.Brush}"
                           IsVisible="{Binding !HasCustomSubstitutions}"
                           Margin="0 0 0 8" />

                <!-- Rules list -->
                <ItemsControl ItemsSource="{Binding CustomSubstitutions}"
                              IsVisible="{Binding HasCustomSubstitutions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubstitutionRuleViewModel">
                            <Grid ColumnDefinitions="*,Auto,*,Auto" Margin="0 0 0 6">
                                <TextBox Grid.Column="0"
                                         Text="{Binding Match}"
                                         Watermark="Say this"
                                         FontSize="12" />
                                <TextBlock Grid.Column="1"
                                           Text="→"
                                           FontSize="12"
                                           Margin="6 0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding Replace}"
                                         Watermark="Type this"
                                         FontSize="12" />
                                <Button Grid.Column="3"
                                        Content="✕"
                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveSubstitutionCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="6 4"
                                        Margin="6 0 0 0"
                                        FontSize="11" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ Add rule"
                        Command="{Binding AddSubstitutionCommand}"
                        Padding="10 5"
                        FontSize="12"
                        Margin="0 4 0 24" />

                <!-- Section: Model -->
                <TextBlock Text="MODEL"
                           FontSize="9"
                           FontWeight="Bold"
                           LetterSpacing="2"
                           Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                           Margin="0 0 0 10" />

                <!-- Model alias -->
                <Grid ColumnDefinitions="160,*" Margin="0 0 0 6">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Model alias"
                                   FontSize="13"
                                   Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        <TextBlock Text="Foundry Local name"
                                   FontSize="10"
                                   Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Text="{Binding TranscriptionModel}"
                             Watermark="nemotron-speech-streaming-en-0.6b"
                             ToolTip.Tip="Foundry Local model alias. Changing this takes effect on next launch." />
                </Grid>
                <TextBlock Text="Changing the model takes effect on next launch."
                           FontSize="10"
                           Foreground="{StaticResource Hush.Text.Muted.Brush}"
                           Margin="0 0 0 24" />

                <!-- Section: Behavior -->
                <TextBlock Text="BEHAVIOR"
                           FontSize="9"
                           FontWeight="Bold"
                           LetterSpacing="2"
                           Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                           Margin="0 0 0 10" />

                <CheckBox Content="Sound effects on start / stop"
                          IsChecked="{Binding SoundEffects}"
                          FontSize="13"
                          Foreground="{StaticResource Hush.Text.Primary.Brush}"
                          Margin="0 0 0 6" />
                <CheckBox IsChecked="{Binding StreamingCommit}"
                          FontSize="13"
                          Foreground="{StaticResource Hush.Text.Primary.Brush}"
                          Margin="0 0 0 2">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Stream text while speaking"
                                   FontSize="13"
                                   Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        <TextBlock Text="Off = all text appears on key release"
                                   FontSize="10"
                                   Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox Content="Launch at login"
                          IsChecked="{Binding AutoStart}"
                          FontSize="13"
                          Foreground="{StaticResource Hush.Text.Primary.Brush}"
                          Margin="0 0 0 6" />

                <!-- Auto-submit key -->
                <Grid ColumnDefinitions="160,*" Margin="0 6 0 10">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Auto-submit key"
                                   FontSize="13" Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        <TextBlock Text="Sent after dictation ends"
                                   FontSize="10" Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AutoSubmitKeyOptions}"
                              SelectedItem="{Binding AutoSubmitKey}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="Optionally press Enter or Ctrl+Enter in the target app after dictation ends. Useful for chat apps." />
                </Grid>

                <!-- Model unload timeout -->
                <Grid ColumnDefinitions="160,*" Margin="0 0 0 24">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Model unload"
                                   FontSize="13" Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        <TextBlock Text="Free RAM when idle"
                                   FontSize="10" Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ModelUnloadTimeoutOptions}"
                              SelectedItem="{Binding ModelUnloadTimeout}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="Unload the transcription model from memory after this idle period to free RAM. It will reload on next dictation." />
                </Grid>

                <!-- Section: Appearance -->
                <TextBlock Text="APPEARANCE"
                           FontSize="9"
                           FontWeight="Bold"
                           LetterSpacing="2"
                           Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                           Margin="0 0 0 10" />

                <Grid ColumnDefinitions="160,*,40" Margin="0 0 0 4">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Overlay opacity"
                                   FontSize="13"
                                   Foreground="{StaticResource Hush.Text.Primary.Brush}" />
                        <TextBlock Text="0.1 – 1.0"
                                   FontSize="10"
                                   Foreground="{StaticResource Hush.Text.Secondary.Brush}" />
                    </StackPanel>
                    <Slider Grid.Column="1"
                            Minimum="0.1" Maximum="1.0"
                            Value="{Binding OverlayOpacity}"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}"
                               FontSize="10"
                               Foreground="{StaticResource Hush.Text.Secondary.Brush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer / action -->
        <Border Grid.Row="2"
                Padding="28 14"
                BorderBrush="{StaticResource Hush.Border.Brush}"
                BorderThickness="0 1 0 0">
            <Button Content="Save &amp; Close"
                    HorizontalAlignment="Right"
                    Padding="18 8"
                    Click="OnSaveClicked" />
        </Border>

    </Grid>
</Window>
