<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hush.App.ViewModels"
        x:Class="Hush.App.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="Hush Overlay"
    Width="420" Height="112"
        SystemDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        FontFamily="{StaticResource Hush.Font}">

    <Panel>

        <!-- ── Preparing state ── -->
        <Border CornerRadius="28"
                Background="#F5FFFFFF"
                BorderBrush="#14000000"
                BorderThickness="1"
                Padding="20 0"
                IsVisible="{Binding IsPreparing}"
                BoxShadow="0 2 12 0 #1A000000">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8"
                         Fill="#9333EA"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Preparing…"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           Margin="10 0 0 0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ModelDownloadProgress, StringFormat={}{0:P0}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#7C3AED"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Listening state: live transcript + waveform ── -->
        <Border CornerRadius="28"
                Background="#F5FFFFFF"
                BorderBrush="#14000000"
                BorderThickness="1"
                Padding="18 12 18 10"
                IsVisible="{Binding IsListening}"
                BoxShadow="0 2 12 0 #1A000000"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,34" RowSpacing="10">
                <Grid>
                    <TextBlock Text="{Binding TranscriptText}"
                               IsVisible="{Binding HasTranscript}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2" />
                    <TextBlock Text="Listening…"
                               IsVisible="{Binding ShowListeningHint}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#475569" />
                </Grid>
                <Canvas Grid.Row="1" x:Name="WaveCanvas" />
            </Grid>
        </Border>

        <!-- ── Error state ── -->
        <Border CornerRadius="28"
                Background="#F2FFFFFF"
                BorderBrush="#14EF4444"
                BorderThickness="1"
                Padding="20 0"
                IsVisible="{Binding HasError}"
                BoxShadow="0 1 8 0 #12000000">
            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6"
                         Fill="#EF4444"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="#DC2626"
                           TextTrimming="CharacterEllipsis"
                           Margin="10 0 0 0"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Panel>

</Window>


