<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hush.App.ViewModels"
        x:Class="Hush.App.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="Hush Overlay"
        Width="180" Height="56"
        SystemDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        FontFamily="{StaticResource Hush.Font}">

    <Panel>

        <!-- ── Preparing state ── -->
        <Border CornerRadius="16"
                Background="#F0FFFFFF"
                BorderBrush="#30475569"
                BorderThickness="1"
                Padding="14 0"
                IsVisible="{Binding IsPreparing}"
                BoxShadow="0 1 8 0 #14000000">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6"
                         Fill="#9333EA"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Preparing…"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           Margin="8 0 0 0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ModelDownloadProgress, StringFormat={}{0:P0}}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#7C3AED"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Listening state: raw mode (purple) ── -->
        <Border CornerRadius="16"
                Background="#F0FFFFFF"
                BorderBrush="#309333EA"
                BorderThickness="1"
                Padding="14 8"
                IsVisible="{Binding IsListeningRaw}"
                BoxShadow="0 1 8 0 #14000000"
                ClipToBounds="True">
            <Canvas x:Name="WaveCanvas" />
        </Border>

        <!-- ── Listening state: clean mode (amber) ── -->
        <Border CornerRadius="16"
                Background="#F0FFFFFF"
                BorderBrush="#30F59E0B"
                BorderThickness="1"
                Padding="14 8"
                IsVisible="{Binding IsListeningClean}"
                BoxShadow="0 1 8 0 #14000000"
                ClipToBounds="True">
            <Canvas x:Name="WaveCanvasClean" />
        </Border>

        <!-- ── Finalizing state: LLM rewrite in progress (amber, "Finishing…") ──
             Warns the user not to click into another window while the cleanse
             pass is running. If focus moves away the final text is dropped to
             avoid leaking into the wrong application. -->
        <Border CornerRadius="16"
                Background="#F0FFFFFF"
                BorderBrush="#40F59E0B"
                BorderThickness="1"
                Padding="14 8"
                IsVisible="{Binding ShowFinalizingHint}"
                BoxShadow="0 1 8 0 #14000000">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Ellipse Width="7" Height="7"
                         Fill="#F59E0B"
                         VerticalAlignment="Center">
                    <Ellipse.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.6" />
                        </Transitions>
                    </Ellipse.Transitions>
                </Ellipse>
                <TextBlock Text="Finishing…  keep this window focused"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#92400E"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ── Error state ── -->
        <Border CornerRadius="16"
                Background="#F0FFFFFF"
                BorderBrush="#40EF4444"
                BorderThickness="1"
                Padding="14 0"
                IsVisible="{Binding HasError}"
                BoxShadow="0 1 6 0 #10000000">
            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <Ellipse Width="5" Height="5"
                         Fill="#EF4444"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorMessage}"
                           FontSize="10"
                           Foreground="#DC2626"
                           TextTrimming="CharacterEllipsis"
                           Margin="8 0 0 0"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Panel>

</Window>


